{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "PublicOrigins": [],
    "AdminOrigins": []
  },
  "RateLimiting": {
    "Public": { "PermitLimit": 100, "Window": "00:00:10" },
    "Admin": { "PermitLimit": 30, "Window": "00:00:10" },
    "Credentials": { "PermitLimit": 10, "Window": "00:01:00" },
    "Webhooks": { "PermitLimit": 300, "Window": "00:00:10" }
  },
  "Session": {
    "AuthAddress": "http://auth-api:8080",
    "AdminIdleTimeout": "00:30:00",
    "RefreshAhead": "00:01:00"
  },
  "ReverseProxy": {
    "Routes": {
      "billing-public": {
        "ClusterId": "billing",
        "Match": { "Path": "/billing/{**remainder}" },
        "Metadata": { "RouteGroup": "public" },
        "Transforms": [ { "PathRemovePrefix": "/billing" } ]
      },
      "billing-webhooks": {
        "ClusterId": "billing",
        "Match": { "Path": "/billing/webhooks/{**remainder}" },
        "Metadata": { "RouteGroup": "webhooks" },
        "Transforms": [ { "PathRemovePrefix": "/billing" } ]
      },
      "billing-admin": {
        "ClusterId": "billing",
        "Match": { "Path": "/admin/billing/{**remainder}" },
        "Metadata": { "RouteGroup": "admin" },
        "Transforms": [ { "PathPattern": "/admin/{**remainder}" } ]
      },
      "catalog-public": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**remainder}" },
        "Metadata": { "RouteGroup": "public" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "catalog-admin": {
        "ClusterId": "catalog",
        "Match": { "Path": "/admin/catalog/{**remainder}" },
        "Metadata": { "RouteGroup": "admin" },
        "Transforms": [ { "PathPattern": "/admin/{**remainder}" } ]
      },
      "auth-admin": {
        "ClusterId": "auth",
        "Match": { "Path": "/admin/auth/{**remainder}" },
        "Metadata": { "RouteGroup": "admin" },
        "Transforms": [ { "PathPattern": "/admin/{**remainder}" } ]
      }
    },
    "Clusters": {
      "billing": {
        "Destinations": {
          "primary": { "Address": "http://billing-api:8080" }
        }
      },
      "catalog": {
        "Destinations": {
          "primary": { "Address": "http://catalog-api:8080" }
        }
      },
      "auth": {
        "Destinations": {
          "primary": { "Address": "http://auth-api:8080" }
        }
      }
    }
  }
}
