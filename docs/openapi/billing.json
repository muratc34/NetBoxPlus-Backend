          "amountMinor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "quality": {
            "$ref": "#/components/schemas/VideoQuality"
          },
          "maxScreens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
