  "components": {
    "schemas": {
      "CheckoutSession": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "CreatedResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "InvoiceStatus": {
        "enum": [
          "Open",
          "PaymentFailed",
          "Paid",
          "Void"
        ]
      },
      "InvoiceSummary": {
        "required": [
          "id",
          "amountMinor",
          "currency",
          "status",
          "issuedAt",
          "paidAt",
          "cardBrand",
          "cardLast4"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amountMinor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "cardBrand": {
            "type": [
              "null",
              "string"
            ]
          },
          "cardLast4": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MySubscription": {
        "required": [
          "id",
          "status",
          "plan",
          "currentPeriodEnd",
          "cancelAtPeriodEnd",
          "canceledAt",
          "startedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
