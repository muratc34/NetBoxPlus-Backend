{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "PublicOrigins": [],
    "AdminOrigins": []
  },
  "RateLimiting": {
    "Public": { "PermitLimit": 100, "Window": "00:00:10" },
    "Admin": { "PermitLimit": 30, "Window": "00:00:10" }
  },
  "ReverseProxy": {
    "Routes": {
      "sample-public": {
        "ClusterId": "sample",
        "Match": { "Path": "/sample/{**remainder}" },
        "Metadata": { "RouteGroup": "public" },
        "Transforms": [ { "PathRemovePrefix": "/sample" } ]
      },
      "sample-admin": {
        "ClusterId": "sample",
        "Match": { "Path": "/admin/sample/{**remainder}" },
        "Metadata": { "RouteGroup": "admin" },
        "Transforms": [ { "PathPattern": "/admin/{**remainder}" } ]
      },
      "feed-public": {
        "ClusterId": "feed",
        "Match": { "Path": "/feed/{**remainder}" },
        "Metadata": { "RouteGroup": "public" },
        "Transforms": [ { "PathRemovePrefix": "/feed" } ]
      }
    },
    "Clusters": {
      "sample": {
        "Destinations": {
          "primary": { "Address": "http://sample-api:8080" }
        }
      },
      "feed": {
        "Destinations": {
          "primary": { "Address": "http://feed-api:8080" }
        }
      }
    }
  }
}
