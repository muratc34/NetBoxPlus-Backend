# Credentials for the local development containers in deploy/compose.yaml.
# ./deploy/dev.ps1 up copies this file to deploy/.env (ignored by git) on first run and replaces
# every "generate" value with a random password. Edit deploy/.env, never this file.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=generate
# Shared by the per-service roles (auth, catalog, billing, streaming).
POSTGRES_SERVICE_PASSWORD=generate

RABBITMQ_USER=netboxplus
RABBITMQ_PASSWORD=generate

VALKEY_PASSWORD=generate

# The first administrator, created by Auth.Migrator ("secrets" copies both into the auth user secrets).
AUTH_ADMIN_EMAIL=admin@netboxplus.local
AUTH_ADMIN_PASSWORD=generate

# Stripe test mode secret key (sk_test_...) for the billing service; leave empty without a Stripe
# account: payments then answer 503. "secrets" copies it into the billing user secrets.
STRIPE_SECRET_KEY=
