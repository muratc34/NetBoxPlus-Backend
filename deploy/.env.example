# Credentials for the local development containers in deploy/compose.yaml.
# ./deploy/dev.ps1 up copies this file to deploy/.env (ignored by git) on first run and replaces
# every "generate" value with a random password. Edit deploy/.env, never this file.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=generate
# Shared by the per-service roles (auth, catalog, billing, streaming, notification).
POSTGRES_SERVICE_PASSWORD=generate

RABBITMQ_USER=netboxplus
RABBITMQ_PASSWORD=generate

VALKEY_PASSWORD=generate

# The first administrator, created by Auth.Migrator ("secrets" copies both into the auth user secrets).
AUTH_ADMIN_EMAIL=admin@netboxplus.local
AUTH_ADMIN_PASSWORD=generate

# Stripe test mode secret key (sk_test_...) for the billing service; leave empty without a Stripe
# account: payments then answer 503. "secrets" copies it into the billing user secrets.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook (whsec_...): "stripe listen --print-secret" prints it.
# Without it the webhook endpoint answers 503.
STRIPE_WEBHOOK_SECRET=

# Where the notification service sends e-mail: Mailpit (the default; caught locally and shown at
# http://localhost:8025, never delivered) or Brevo (real delivery). Brevo needs the two values below:
# an API key and a sender address verified in that Brevo account. The key alone does not switch.
EMAIL_PROVIDER=Mailpit
BREVO_API_KEY=
EMAIL_FROM=

# Signing keys, created by ./deploy/dev.ps1 on first run and appended to deploy/.env (not listed
# here): AUTH_TOKEN_KEY_ID and AUTH_TOKEN_SIGNING_KEY (a P-256 private key, PEM on one line) sign
# access tokens, PLAYBACK_SIGNING_KEY signs playlist addresses. Kept once made: a new token key
# ends every session. "secrets" copies them into the auth and streaming user secrets.
