<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear machine-specific sources (such as the Visual Studio offline feed) so every build restores from the same feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
