            "format": "int32"
          }
        }
      },
      "PlanDetails": {
        "required": [
          "id",
          "name",
          "translations",
          "amountMinor",
          "currency",
          "quality",
          "maxScreens",
          "providerPriceId",
          "isActive",
          "version",
          "createdAt",
          "modifiedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "translations": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/PlanTextFields"
